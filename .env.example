# LiveKit OSS server, running locally via docker-compose (--dev mode).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent dispatch name — must match `agent_name=` in agent/worker.py.
AGENT_NAME=open-voice-agent

# Local OpenAI-compatible service URLs.
STT_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-base.en

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b

TTS_BASE_URL=http://localhost:8880/v1
TTS_MODEL=tts-1
TTS_VOICE=af_bella
